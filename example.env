# Optional: the app's Settings page is the easiest way to add keys.
# Or copy this file to .env and fill in the keys for the providers you use; a provider
# with a key here is switched on automatically. Keys saved in Settings take precedence.
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_API_KEY=

# Optional: creates a "Custom" endpoint on first run (add more in Settings)
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
