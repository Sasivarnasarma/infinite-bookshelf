# Infinite Bookshelf settings. Copy to .env (next to docker-compose.yml) and change what you need.
# Used by both `pnpm dev` and `docker compose`. Every setting is optional; the defaults are shown.
# API keys don't go here: users add them in the app's Settings, and they stay in their browser.

# Let the server reach local model servers (Ollama, LM Studio) and other private addresses.
# Turn this off on a server other people use, or they could make it call your private network.
IB_ALLOW_PRIVATE_ENDPOINTS=true

# Let users add their own OpenAI-compatible base URLs.
# IB_ALLOW_CUSTOM_ENDPOINTS=true

# Writing requests per minute per visitor IP; 0 means no limit. Set one on a public server.
# IB_RATE_LIMIT_PER_MINUTE=0

# Reverse proxies (nginx, Caddy) whose X-Forwarded-For header gives each visitor's IP for the rate
# limit: comma-separated addresses or networks, or *. Others can't fake their IP. The Docker image
# already trusts a proxy on the same machine (127.0.0.1 and Docker's networks, 172.16.0.0/12).
# IB_TRUSTED_PROXIES=127.0.0.1

# Largest accepted request, in bytes (a section request carries the book written so far).
# IB_MAX_REQUEST_BYTES=8000000

# Interactive API docs at /api/docs.
# IB_DOCS_ENABLED=true

# Other websites allowed to call the API from a browser, as a JSON list. The app itself needs none.
# IB_CORS_ORIGINS=["https://example.com"]

# Address and port when running from source: `pnpm dev` uses 127.0.0.1:8000 and `pnpm start`
# 0.0.0.0:9752 unless these are set. Docker ignores them: the container always listens on
# 0.0.0.0:9752 (change the published port in docker-compose.yml instead).
# IB_HOST=127.0.0.1
# IB_PORT=8000
